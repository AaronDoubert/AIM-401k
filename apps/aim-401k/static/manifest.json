{
  "manifest_version": 3,
  "name": "AIM-401k",
  "version": "0.2.0",
  "description": "AIM-401k: autonomous employment acquisition. Fills and tracks job applications, pings you only when a human is needed. All data stays local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aim-401k@slop.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["personallyIdentifyingInfo", "websiteContent", "personalCommunications"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms",
    "unlimitedStorage",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "mail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIM-401k",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
