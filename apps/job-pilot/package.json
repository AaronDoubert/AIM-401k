{
  "name": "job-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firefox extension that semi-autonomously fills and tracks job applications, pinging you only when a human is needed.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "pdfjs-dist": "^5.7.284",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
