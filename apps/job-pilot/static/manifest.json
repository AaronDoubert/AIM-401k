{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.1.0",
  "description": "Semi-autonomous job application assistant: fills forms, tracks applications, and pings you only when a human is needed.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jobpilot@slop.local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage", "tabs", "notifications", "alarms", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "JobPilot",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
